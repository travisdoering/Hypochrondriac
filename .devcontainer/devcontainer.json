{
  "name": "Hypochondriac",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Hypochondriac", "onAutoForward": "openPreview" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Your Anthropic API key, so the chat works without pasting it into Settings.",
      "documentationUrl": "https://console.anthropic.com/"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss", "esbenp.prettier-vscode"]
    }
  }
}
